# --- Microsoft Entra (Azure AD) app registration ---
# Fill in the values from your app registration. Then run:
#   python -m todo_planner_mcp.server --check   (offline sanity check)
#   python -m todo_planner_mcp.server --login   (one-time browser sign-in)

# Application (client) ID
TPM_CLIENT_ID=your-app-client-id-here

# Directory (tenant) ID. When set, overrides TPM_AUTHORITY.
TPM_TENANT_ID=

# Client secret VALUE (not the secret ID).
#   Set   -> confidential client, browser sign-in via TPM_REDIRECT_URI.
#            App reg: Authentication -> add platform "Web" -> redirect URI below.
#   Empty -> public client, device-code sign-in.
#            App reg: Authentication -> Allow public client flows = Yes.
TPM_CLIENT_SECRET=

# Must exactly match a "Web" redirect URI on the app registration (secret mode only).
TPM_REDIRECT_URI=http://localhost:8400/callback

# Fallback authority if TPM_TENANT_ID is empty:
#   common | consumers | organizations | <tenant-id>
# Planner requires a work/school account (consumers = To Do only).
TPM_AUTHORITY=organizations

# Space-separated delegated scopes.
#   User.Read        -> /me (always added if missing)
#   Tasks.ReadWrite  -> To Do + Planner tasks
#   Group.Read.All   -> Planner plan member lookup (needs tenant-admin consent)
#   User.ReadBasic.All -> names/emails of plan members (planner_find_member)
#   Notes.Read.All   -> OneNote read-only tools, incl. team (group) notebooks
TPM_SCOPES=User.Read User.ReadBasic.All Tasks.ReadWrite Group.Read.All Notes.Read.All

# Opt-in guardrail: Entra group (display name or object id) of people who have signed up.
# Planner changes that involve anyone outside it need the user's explicit confirmation.
# Empty -> every other person counts as not signed up.
TPM_OPTIN_GROUP=

# Where to persist the MSAL token cache (keep this file private).
TPM_TOKEN_CACHE=~/.todo_planner_mcp/token_cache.bin
